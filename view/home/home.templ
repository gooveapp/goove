package home

import (
  "github.com/gooveapp/goove/view/layout"
)

templ Home() {
  @layout.Base("Home") {
			<main class="flex-1 flex items-center justify-center">
				<div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
					<div class="text-center">
						<h2 class="text-4xl font-extrabold text-foreground sm:text-5xl">
							Welcome to <span class="text-primary">Goove</span>
						</h2>
						<p class="mt-4 text-xl text-muted-foreground">
							Your personal vinyl collection manager
						</p>
						<div class="mt-8">
							<a href="/records/new" class="inline-flex items-center justify-center bg-primary text-primary-foreground px-6 py-3 rounded-lg text-lg font-medium hover:bg-primary/90 transition-colors">
								Add Your First Record
							</a>
						</div>
					</div>
				</div>
			</main>
  }
}
