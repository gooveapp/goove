package layout

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } - Goove</title>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<script src="/static/js/htmx.min.js" defer></script>
      <script src="/static/js/alpinejs@3.min.js" defer></script>
		</head>
		<body class="min-h-screen bg-background text-foreground antialiased">
		<div class="min-h-screen flex flex-col">
			<nav class="border-b border-border bg-card">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="flex justify-between h-16 items-center">
						<h1 class="text-2xl font-bold text-primary">Goove</h1>
						<div class="flex items-center space-x-6">
							<a href="/" class="text-foreground hover:text-primary transition-colors">Home</a>
							<a href="/records" class="text-muted-foreground hover:text-primary transition-colors">Records</a>
							<a href="/settings" class="text-muted-foreground hover:text-primary transition-colors">Settings</a>
						</div>
					</div>
				</div>
			</nav>

			{ children... }

		</div>
		</body>
	</html>
}
